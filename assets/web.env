# Env for the Flutter WEB build served by the Next.js portal (/flutter).
# Non-dotfile on purpose: Next refuses to serve /flutter/assets/.env (400),
# which left dotenv uninitialized in the browser. Select it with
#   --dart-define=ENV_FILE=web.env
# The portal page still overrides api_base/socket_url per-embed via query
# params; these are the same-origin defaults.
#
# SERVICE_TOKEN stays EMPTY here: on web every REST call goes through the
# portal's same-origin proxies, which attach the real token server-side —
# the public JS bundle must not embed it.
API_BASE_URL=http://localhost:3000/api
CHAT_SERVER_URL=ws://localhost:5001/socket/websocket
DEV_MODE=true
DEBBUG_MODE=false
SERVICE_TOKEN=
ELEVENLABS_VOICE_ENABLED=false
